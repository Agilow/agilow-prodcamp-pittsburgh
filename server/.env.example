OPENAI_API_KEY=
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Optional: enables JS-rendered careers-page scraping for hiring signals.
FIRECRAWL_API_KEY=
PORT=8787
# Shared secret for POST /api/scout (the automated Reddit sweep).
# Generate with: openssl rand -hex 32
# Unset = the scout route is disabled (503), never public.
SCOUT_SECRET=
# Optional: override the cheap triage model used by the scout pre-filter.
SCOUT_PREFILTER_MODEL=
